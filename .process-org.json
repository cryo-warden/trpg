{
  "processes": {
    "check": {
      "command": [
        "bun",
        "run",
        "check"
      ],
      "dir": "."
    },
    "generate": {
      "command": [
        "bun",
        "run",
        "stdb-generate"
      ],
      "dir": "."
    },
    "test-rust": {
      "command": [
        "cargo",
        "test"
      ],
      "dir": "."
    },
    "test-web": {
      "command": [
        "bun",
        "test",
        "src"
      ],
      "dir": "web-trpg"
    },
    "test-e2e-smoke": {
      "command": [
        "bun",
        "test",
        "e2e/0-smoke.test.ts"
      ],
      "dir": "web-trpg"
    },
    "test-e2e-assets": {
      "command": [
        "bun",
        "test",
        "e2e/1-assets.test.ts"
      ],
      "dir": "web-trpg"
    },
    "dev": {
      "command": [
        "bun",
        "run",
        "dev"
      ],
      "dir": "."
    },
    "spacetime": {
      "command": [
        "spacetime",
        "start"
      ],
      "dir": "."
    },
    "publish": {
      "command": [
        "spacetime",
        "publish",
        "--module-path",
        "./server",
        "trpg",
        "--delete-data",
        "--yes"
      ],
      "dir": "."
    },
    "test": {
      "bundle": [
        "test-web",
        "test-rust"
      ]
    },
    "verify": {
      "bundle": [
        "check",
        "test",
        "test-e2e"
      ]
    },
    "test-e2e": {
      "bundle": [
        "test-e2e-smoke",
        "test-e2e-assets"
      ]
    }
  }
}
