    "test-e2e-production": {
      "command": [
        "bun",
        "test",
        "e2e/8-production.test.ts"
      ],
      "dir": "web-trpg"
    },
    "test-e2e-loadout": {
      "command": [
        "bun",
        "test",
        "e2e/9-loadout.test.ts"
      ],
      "dir": "web-trpg"
