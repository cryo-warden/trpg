    "test-e2e-morale": {
      "command": [
        "bun",
        "test",
        "e2e/10-morale.test.ts"
      ],
      "dir": "web-trpg"
    },
    "test-e2e-dive": {
      "command": [
        "bun",
        "test",
        "e2e/11-dive.test.ts"
      ],
      "dir": "web-trpg"
    },
    "test-e2e-death": {
      "command": [
        "bun",
        "test",
        "e2e/12-death.test.ts"
      ],
      "dir": "web-trpg"
    },
    "dev": {
      "command": [
        "bun",
        "run",
        "dev"
      ],
      "dir": "."
    },
    "spacetime": {
      "command": [
        "spacetime",
        "start"
      ],
      "dir": "."
    },
    "publish": {
      "command": [
        "bash",
        "scripts/publish.sh",
        "trpg"
      ],
      "dir": "."
    },
    "publish-dev-bare": {
      "command": [
        "bun",
        "scripts/dev-publish.ts",
        "bare"
      ],
      "dir": "web-trpg"
    },
    "publish-dev-seeded": {
      "command": [
        "bun",
        "scripts/dev-publish.ts",
        "seeded"
      ],
