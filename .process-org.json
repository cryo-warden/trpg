{
  "processes": {
    "check": {
      "command": [
        "bun",
        "run",
        "check"
      ],
      "cwd": "."
    },
    "generate": {
      "command": [
        "bun",
        "run",
        "stdb-generate"
      ],
      "cwd": "."
    },
    "test-rust": {
      "command": [
        "cargo",
        "test"
      ],
      "cwd": "."
    },
    "test-web": {
      "command": [
        "bun",
        "test",
        "--preload",
        "./web-trpg/happydom.ts"
      ],
      "cwd": "."
    },
    "dev": {
      "command": [
        "bun",
        "run",
        "dev"
      ],
      "cwd": "."
    },
    "spacetime": {
      "command": [
        "spacetime",
        "start"
      ],
      "cwd": "."
    },
    "publish": {
      "command": [
        "spacetime",
        "publish",
        "--module-path",
        "./server",
        "trpg",
        "--delete-data",
        "--yes"
      ],
      "cwd": "."
    },
    "test": {
      "bundle": [
        "test-web",
        "test-rust"
      ]
    },
    "verify": {
      "bundle": [
        "check",
        "test"
      ]
    }
  }
}
