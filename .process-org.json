    },
    "publish-dev-combat": {
      "command": [
        "bun",
        "scripts/dev-publish.ts",
        "combat"
      ],
      "dir": "web-trpg"
    },
    "publish-dev-mapgen": {
      "command": [
        "bun",
        "scripts/dev-publish.ts",
        "mapgen"
      ],
      "dir": "web-trpg"
    },
    "test": {
      "bundle": [
        "test-web",
        "test-rust"
      ]
    },
    "verify": {
      "bundle": [
        "check",
        "clippy",
        "test",
        "test-e2e"
      ]
    },
    "test-e2e": {
      "bundle": [
        "test-e2e-smoke",
        "test-e2e-assets",
        "test-e2e-world",
        "test-e2e-map",
        "test-e2e-combat",
        "test-e2e-mapgen",
        "test-e2e-login",
        "test-e2e-stances",
        "test-e2e-production",
        "test-e2e-loadout",
        "test-e2e-morale",
        "test-e2e-dive",
        "test-e2e-death"
      ]
