{
  "processes": {
    "check": {
      "command": [
        "bun",
        "run",
        "check"
      ],
      "dir": "."
    },
    "generate": {
      "command": [
        "bun",
        "run",
        "stdb-generate"
      ],
      "dir": "."
    },
    "test-rust": {
      "command": [
        "cargo",
        "test"
      ],
      "dir": "."
    },
    "clippy": {
      "command": [
        "cargo",
        "clippy",
        "--all-targets"
      ],
      "dir": "."
    },
    "test-web": {
      "command": [
        "bun",
        "test",
        "src"
      ],
      "dir": "web-trpg"
    },
    "test-e2e-smoke": {
      "command": [
        "bun",
        "test",
        "e2e/0-smoke.test.ts"
      ],
