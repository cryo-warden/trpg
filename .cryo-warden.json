{
  "name": "trpg",
  "processes": [
    {
      "name": "spacetimedb",
      "start_command": "bash scripts/prod-stdb.sh",
      "proxied_ports": ["TRPG_STDB_PORT"]
    },
    {
      "name": "web",
      "start_command": "bash scripts/prod-web.sh",
      "proxied_ports": ["TRPG_WEB_PORT"]
    }
  ],
  "build_command": "bash -c 'cd web-trpg && bun install && bun run build'",
  "required_environment_variables": [
    "TRPG_STDB_PORT",
    "TRPG_WEB_PORT",
    "TRPG_STDB_DATA_DIR",
    "TRPG_ADMIN_TOKEN",
    "CARGO_TARGET_DIR"
  ]
}
