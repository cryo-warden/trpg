{
  "name": "trpg",
  "processes": [
    {
      "name": "spacetimedb",
      "startCommand": "bash scripts/prod-stdb.sh",
      "proxiedPorts": ["TRPG_STDB_PORT"]
    },
    {
      "name": "web",
      "startCommand": "bash scripts/prod-web.sh",
      "proxiedPorts": ["TRPG_WEB_PORT"]
    }
  ],
  "buildCommand": "bash -c 'cd web-trpg && bun install && bun run build'",
  "requiredEnvironmentVariables": [
    "TRPG_STDB_PORT",
    "TRPG_WEB_PORT",
    "TRPG_STDB_DATA_DIR",
    "TRPG_STDB_DELETE_DATA",
    "TRPG_AUTO_ENTRY",
    "TRPG_ADMIN_TOKEN",
    "CARGO_TARGET_DIR"
  ]
}
