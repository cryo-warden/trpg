{
  "homepage": "http://cryo-warden.github.io/trpg",
  "name": "web-trpg",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "stdb-generate": "spacetime generate --project-path ../server --lang typescript --out-dir ./src/stdb",
    "ts-check": "bun tsc -b",
    "lint": "bun run eslint .",
    "check": "bun run stdb-generate && bun run lint && bun run ts-check",
    "dev": "bun run check && vite",
    "build": "bun run check -b && vite build",
    "preview": "vite preview",
    "predeploy": "bun run build",
    "deploy": "gh-pages -d ./dist"
  },
  "dependencies": {
    "@clockworklabs/spacetimedb-sdk": "^1.3.3",
    "gh-pages": "^6.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.11"
  }
}
