{
  "homepage": "http://cryo-warden.github.io/trpg",
  "name": "web-trpg",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "stdb-generate": "spacetime generate --module-path ../server --lang typescript --out-dir ./src/stdb --yes",
    "ts-check": "bun tsc -b",
    "test": "bun test",
    "lint": "bun run eslint .",
    "check": "bun run stdb-generate && bun run lint && bun run ts-check",
    "dev": "bun run check && TRPG_STDB_PORT=3000 TRPG_AUTO_ENTRY=true vite",
    "serve": "TRPG_STDB_PORT=3000 TRPG_AUTO_ENTRY=true vite",
    "serve-login": "TRPG_STDB_PORT=3000 vite",
    "build": "bun run check -b && vite build",
    "preview": "vite preview",
    "predeploy": "bun run build",
    "deploy": "gh-pages -d ./dist"
  },
  "dependencies": {
    "gh-pages": "^6.3.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "spacetimedb": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^20.11.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.0.3"
  }
}
